{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "globalEnv": ["GOOGLE_CLOUD_PROJECT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "env": ["GOOGLE_CLOUD_PROJECT"],
      "cache": false,
      "persistent": true
    }
  }
}
