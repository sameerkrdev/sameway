# Copy to .env.local and fill in.
# Every phase of the app runs without these values; the routing engine falls
# back to MockRoutingEngine and shows a persistent banner saying so.

# Enable on the Cloud project: Maps JavaScript API, Routes API,
# Places API (New), Geocoding API.
# Leave the LEGACY Directions API, Distance Matrix API and Places API DISABLED.
VITE_GOOGLE_MAPS_API_KEY=

# Required for AdvancedMarker rendering (cloud-based map styling).
VITE_GOOGLE_MAPS_MAP_ID=

# Route Optimization (dev-server proxy only; see README).
# Enable Route Optimization API on the project. Create a service account with
# access to it, download a JSON key, and point here — never commit the key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
